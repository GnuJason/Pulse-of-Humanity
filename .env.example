# Environment Variables for Pulse of Humanity

# Flask Configuration
FLASK_DEBUG=0
FLASK_SECRET_KEY=your-secret-key-here-generate-a-strong-random-key

# Server Configuration  
PORT=10000
RUN_UPDATER=1

# API Keys (Optional but recommended)
API_NINJAS_KEY=your-api-ninjas-key-here

# Email Configuration (Optional - for contact form)
SMTP_SERVER=smtp.mailfence.com
SMTP_PORT=587
SMTP_USERNAME=your-email@mailfence.com
SMTP_PASSWORD=your-app-password
RECIPIENT_EMAIL=your-inbox@example.com

# Production Settings
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com